<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp">

        <View
            android:id="@+id/storyRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_story_ring" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/storyAvatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_circle_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeCircle" />

        <ImageView
            android:id="@+id/addBadge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_pill_blue"
            android:padding="4dp"
            android:src="@drawable/ic_add"
            android:visibility="gone"
            app:tint="@color/white" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvStoryName"
        android:layout_width="68dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Name"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
</LinearLayout>
