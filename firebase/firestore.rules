rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['createdAt']);
      allow delete: if isSelf(userId);

      match /saves/{postId} {
        allow read, write: if isSelf(userId);
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }

    match /friendships/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.requester == request.auth.uid;
      allow update, delete: if signedIn()
        && (resource.data.requester == request.auth.uid
            || resource.data.addressee == request.auth.uid);
    }

    match /follows/{id} {
      allow read: if signedIn();
      allow create, delete: if signedIn()
        && request.resource.data.follower == request.auth.uid
        || (resource != null && resource.data.follower == request.auth.uid);
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      match /views/{uid} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }
    }

    match /conversations/{conversationId} {
      allow read, update: if signedIn()
        && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if signedIn();
      }
      match /typing/{uid} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }
    }

    match /notifications/{id} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn();
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /blocks/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.blocker == request.auth.uid;
      allow delete: if signedIn() && resource.data.blocker == request.auth.uid;
    }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporter == request.auth.uid;
      allow read: if false;
    }
  }
}
